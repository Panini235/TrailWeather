    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/shanqing_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/shanqing_splash_blank</item>
    </style>
</resources>
